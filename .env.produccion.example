# Configuración para el servidor de producción (hosting con dominio y SSL).
# Copia este archivo como .env en el servidor y completa los valores marcados con ********.
# Después ejecuta: php artisan key:generate  (solo la primera vez)

APP_NAME="Rialto 7"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.tudominio.com

# Español de Venezuela; la zona horaria ya está fija en config/app.php (America/Caracas)
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Base de datos creada en cPanel → Bases de datos MySQL
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=usuario_rialto7
DB_USERNAME=usuario_rialto7
DB_PASSWORD=********

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
# 1 día: la cotización que un cliente arma sin enviar dura 24 horas
SESSION_LIFETIME=1440
# Las cookies de sesión solo viajan por HTTPS
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local

# Correo para «¿Olvidaste tu contraseña?». Datos en cPanel → Cuentas de correo → Configurar cliente
MAIL_MAILER=smtp
MAIL_HOST=mail.tudominio.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=no-responder@tudominio.com
MAIL_PASSWORD=********
MAIL_FROM_ADDRESS="no-responder@tudominio.com"
MAIL_FROM_NAME="Inversiones Rialto 7"
